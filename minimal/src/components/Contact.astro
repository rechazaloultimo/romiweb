---
// Contact / WhatsApp section
// Reemplazá el número con tu número real (formato internacional sin + ni espacios)
const whatsappNumber = '5491100000000'; // ← CAMBIÁ ESTE NÚMERO
const whatsappMessage = encodeURIComponent('Hola! Me interesa saber más sobre los talleres de crochet 🧶');
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section class="contact" id="contacto">
  <div class="contact-inner">

    <div class="contact-content">
      <p class="section-eyebrow">✦ Hablemos</p>
      <h2 class="contact-title">¿Querés aprender<br/><em>crochet</em>?</h2>
      <p class="contact-text">
        Escribime por WhatsApp y coordinamos una clase de prueba.
        Sin compromiso, con mucha onda.
      </p>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="whatsapp-btn"
        aria-label="Contactar por WhatsApp"
      >
        <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Escribime por WhatsApp
      </a>

      <p class="contact-note">También podés consultar por encargos de piezas.</p>
    </div>

    <div class="contact-visual">
      <!-- Decoración geométrica tipo tejido circular -->
      <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" class="contact-mandala">
        <g stroke="var(--violet-light)" fill="none">
          <!-- Anillos -->
          <circle cx="120" cy="120" r="100" stroke-width="1" stroke-dasharray="4 6"/>
          <circle cx="120" cy="120" r="78" stroke-width="1.5"/>
          <circle cx="120" cy="120" r="55" stroke-width="1"/>
          <circle cx="120" cy="120" r="32" stroke-width="2"/>
          <circle cx="120" cy="120" r="10" fill="var(--violet)" stroke="none"/>
          <!-- Radiales 8 -->
          <line x1="120" y1="20" x2="120" y2="220" stroke-width="0.5" opacity="0.4"/>
          <line x1="20" y1="120" x2="220" y2="120" stroke-width="0.5" opacity="0.4"/>
          <line x1="49" y1="49" x2="191" y2="191" stroke-width="0.5" opacity="0.4"/>
          <line x1="191" y1="49" x2="49" y2="191" stroke-width="0.5" opacity="0.4"/>
          <!-- Puntos decorativos -->
          <circle cx="120" cy="42" r="4" fill="var(--violet)" stroke="none"/>
          <circle cx="120" cy="198" r="4" fill="var(--violet)" stroke="none"/>
          <circle cx="42" cy="120" r="4" fill="var(--violet)" stroke="none"/>
          <circle cx="198" cy="120" r="4" fill="var(--violet)" stroke="none"/>
          <circle cx="64" cy="64" r="3" fill="var(--violet-light)" stroke="none"/>
          <circle cx="176" cy="64" r="3" fill="var(--violet-light)" stroke="none"/>
          <circle cx="176" cy="176" r="3" fill="var(--violet-light)" stroke="none"/>
          <circle cx="64" cy="176" r="3" fill="var(--violet-light)" stroke="none"/>
        </g>
      </svg>
    </div>

  </div>

  <div class="contact-footer">
    <p>Hecho con 🧶 y mucho amor · Textil Studio</p>
  </div>
</section>

<style>
  .contact {
    background: var(--green-wa);
    padding: 5rem 1.5rem 2rem;
    position: relative;
    overflow: hidden;
  }

  .contact-inner {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .section-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    font-weight: 500;
    margin-bottom: 0.75rem;
  }

  .contact-title {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    color: white;
    margin-bottom: 1.25rem;
    line-height: 1.05;
  }

  .contact-title em {
    font-style: italic;
    color: rgba(255,255,255,0.85);
  }

  .contact-text {
    font-size: 1rem;
    color: rgba(255,255,255,0.85);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 380px;
  }

  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: white;
    color: #128C7E;
    padding: 1rem 2rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 50px;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
  }

  .whatsapp-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 8px 30px rgba(0,0,0,0.25);
  }

  .wa-icon {
    width: 24px;
    height: 24px;
    color: #25D366;
  }

  .contact-note {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: rgba(255,255,255,0.6);
  }

  /* Mandala visual */
  .contact-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-mandala {
    width: 220px;
    height: 220px;
    animation: rotateMandala 30s linear infinite;
    opacity: 0.7;
  }

  @keyframes rotateMandala {
    to { transform: rotate(360deg); }
  }

  /* Footer strip */
  .contact-footer {
    text-align: center;
    padding-top: 3rem;
    color: rgba(255,255,255,0.5);
    font-size: 0.82rem;
    letter-spacing: 0.05em;
  }

  @media (max-width: 620px) {
    .contact-inner {
      grid-template-columns: 1fr;
    }
    .contact-visual {
      order: -1;
    }
    .contact-mandala {
      width: 140px;
      height: 140px;
    }
  }
</style>