---
// Modal flotante para mostrar imágenes en grande con información de la producción
---

<div id="imageModal" class="image-modal">
  <div class="modal-overlay"></div>
  <div class="modal-container">
    <button class="modal-close" id="modalClose" aria-label="Cerrar modal">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    
    <div class="modal-content">
      <img id="modalImage" src="" alt="" class="modal-image" />
      
      <div class="modal-info">
        <h3 id="modalTitle" class="modal-title"></h3>
        
        <div class="info-grid">
          <div class="info-item">
            <span class="info-label">⏱️ Tiempo de proceso</span>
            <span id="modalTime" class="info-value"></span>
          </div>
          <div class="info-item">
            <span class="info-label">🧶 Gancho</span>
            <span id="modalHook" class="info-value"></span>
          </div>
          <div class="info-item">
            <span class="info-label">✨ Técnica</span>
            <span id="modalTechnique" class="info-value"></span>
          </div>
          <div class="info-item">
            <span class="info-label">🎨 Materiales</span>
            <span id="modalMaterials" class="info-value"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('imageModal');
    const modalClose = document.getElementById('modalClose');
    const modalOverlay = document.querySelector('.modal-overlay');
    
    if (!modal) return;
    
    // Cerrar modal
    const closeModal = () => {
      modal.classList.remove('active');
      document.body.style.overflow = 'auto';
    };

    modalClose?.addEventListener('click', closeModal);
    modalOverlay?.addEventListener('click', closeModal);

    // Cerrar con ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });

    // Función para abrir modal con datos
    window.openImageModal = (data) => {
      const imgElement = document.getElementById('modalImage');
      if (imgElement) {
        imgElement.src = data.src;
        imgElement.alt = data.alt;
      }
      const titleEl = document.getElementById('modalTitle');
      if (titleEl) titleEl.textContent = data.title;
      
      const timeEl = document.getElementById('modalTime');
      if (timeEl) timeEl.textContent = data.time;
      
      const hookEl = document.getElementById('modalHook');
      if (hookEl) hookEl.textContent = data.hook;
      
      const techEl = document.getElementById('modalTechnique');
      if (techEl) techEl.textContent = data.technique;
      
      const matEl = document.getElementById('modalMaterials');
      if (matEl) matEl.textContent = data.materials;
      
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    };

    // Event listeners para los botones del portfolio
    document.querySelectorAll('.portfolio-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        window.openImageModal({
          src: this.dataset.src || '',
          alt: this.dataset.alt || '',
          title: this.dataset.title || '',
          time: this.dataset.time || '',
          hook: this.dataset.hook || '',
          technique: this.dataset.technique || '',
          materials: this.dataset.materials || ''
        });
      });
    });
  });
</script>

<style>
  .image-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-in-out;
  }

  .image-modal.active {
    opacity: 1;
    pointer-events: auto;
  }

  .modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(26, 16, 24, 0.8);
    backdrop-filter: blur(4px);
  }

  .modal-container {
    position: relative;
    z-index: 1000;
    background: var(--white);
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    max-width: 90vw;
    max-height: 90vh;
    overflow-y: auto;
    width: 100%;
  }

  /* Responsive: en móvil */
  @media (max-width: 768px) {
    .modal-container {
      max-width: 95vw;
      max-height: 95vh;
    }
  }

  .modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: rgba(139, 77, 168, 0.1);
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--violet);
    transition: background-color 0.2s;
    z-index: 1001;
  }

  .modal-close:hover {
    background: rgba(139, 77, 168, 0.2);
  }

  .modal-close svg {
    width: 24px;
    height: 24px;
  }

  .modal-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 2rem;
  }

  /* Responsive: en móvil */
  @media (max-width: 768px) {
    .modal-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.5rem;
    }
  }

  .modal-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 12px;
    max-height: 500px;
  }

  .modal-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .modal-title {
    font-family: "Playfair Display", serif;
    font-size: 1.75rem;
    color: var(--text-dark);
    margin: 0;
    font-weight: 700;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  .info-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .info-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-light);
    font-weight: 500;
  }

  .info-value {
    font-size: 1rem;
    color: var(--text-dark);
    font-weight: 500;
  }
</style>
