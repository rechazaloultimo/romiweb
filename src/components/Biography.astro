---
// Biography / Hero section
import '../styles/biography.css';
---

<section class="biography crochet-bg" id="biografia">
  <div class="bio-inner ">
    <div class="bio-image-slot">
      <!-- Reemplazá src con tu foto real -->
      <img src="src/images/fotoperfil.jpg" alt="Foto de perfil" class="bio-photo" />
      <div class="bio-photo-placeholder" aria-hidden="true">
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <circle cx="60" cy="45" r="28" fill="#B07CC6" opacity="0.6"/>
          <ellipse cx="60" cy="105" rx="45" ry="28" fill="#B07CC6" opacity="0.6"/>
        </svg>
        <span>Tu foto</span>
      </div>
    </div>

    <div class="bio-content">
      <div class="bio-card">
        <p class="bio-eyebrow">✦ Artesana por placer ✦</p>
        <h1 class="bio-name">Romi on Crochet</h1>
        <p class="bio-tagline">
          Creo con hilo, enseño con paciencia.<br/>
          <em>Cada trama invita a la relajación.</em>
        </p>
        <p class="bio-description">
          Soy artesana textil especializada en crochet. Trabajo piezas únicas
          y doy clases personalizadas para que vos también puedas crear algo
          hermoso con tus propias manos.
        </p>
        
      </div>
    </div>
  </div>
</section>