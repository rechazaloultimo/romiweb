---
// Modal flotante tipo Carrusel
import '../styles/image-modal.css';
---

<div id="imageModal" class="image-modal">
  <div class="modal-overlay"></div>
  
  <div class="modal-container">
    <button class="modal-close" id="modalClose" aria-label="Cerrar modal">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <div class="modal-content">
      <div class="modal-visual">
        <button class="nav-btn prev" id="prevBtn" aria-label="Anterior">‹</button>
        <img id="modalImage" src="" alt="" class="modal-image" />
        <button class="nav-btn next" id="nextBtn" aria-label="Siguiente">›</button>
      </div>
      
      <div class="modal-info">
        <h3 id="modalTitle" class="modal-title"></h3>
        
        <div class="info-grid">
          <div class="info-item">
            <span class="info-label">⏱️ Tiempo de proceso</span>
            <span id="modalTime" class="info-value"></span>
          </div>
          <div class="info-item">
            <span class="info-label">🧶 Gancho</span>
            <span id="modalHook" class="info-value"></span>
          </div>
          <div class="info-item">
            <span class="info-label">✨ Técnica</span>
            <span id="modalTechnique" class="info-value"></span>
          </div>
          <div class="info-item">
            <span class="info-label">🎨 Materiales</span>
            <span id="modalMaterials" class="info-value"></span>
          </div>
          <div class="info-item">
            <span class="info-label">💡 Uso recomendado</span>
            <span id="modalUsage" class="info-value"></span>
          </div>
          <div class="info-item">
            <span class="info-label">⚖️ Cantidad de material</span>
            <span id="modalAmount" class="info-value"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('imageModal');
    const imgElement = document.getElementById('modalImage');
    let projectImages = []; // Aquí guardaremos las fotos del proyecto abierto
    let currentIndex = 0;

    // Función para mostrar la imagen según el índice
    const updateImage = (index) => {
      currentIndex = index;
      imgElement.src = projectImages[currentIndex];
    };

    // Al hacer clic en un trabajo del portfolio
    document.querySelectorAll('.portfolio-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        // 1. Cargamos la lista de imágenes desde el data-images
        projectImages = this.dataset.images.split(',');
        
        // 2. Llenamos la información (Zona Verde)
        document.getElementById('modalTitle').textContent = this.dataset.title;
        document.getElementById('modalTime').textContent = this.dataset.time;
        document.getElementById('modalHook').textContent = this.dataset.hook;
        document.getElementById('modalTechnique').textContent = this.dataset.technique;
        document.getElementById('modalMaterials').textContent = this.dataset.materials;
        document.getElementById('modalUsage').textContent = this.dataset.usage;
        document.getElementById('modalAmount').textContent = this.dataset.amount;

        // 3. Mostramos la primera imagen y abrimos
        updateImage(0);
        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    // Flechas: ahora navegan dentro de projectImages
    document.getElementById('nextBtn').onclick = () => {
      updateImage((currentIndex + 1) % projectImages.length);
    };

    document.getElementById('prevBtn').onclick = () => {
      updateImage((currentIndex - 1 + projectImages.length) % projectImages.length);
    };

    // Cerrar modal
    const closeModal = () => {
      modal.classList.remove('active');
      document.body.style.overflow = 'auto';
    };

    document.getElementById('modalClose')?.addEventListener('click', closeModal);
    document.querySelector('.modal-overlay')?.addEventListener('click', closeModal);

    // Teclado (Flechas y Esc)
    document.addEventListener('keydown', (e) => {
      if (!modal.classList.contains('active')) return;
      if (e.key === 'ArrowRight') updateImage((currentIndex + 1) % projectImages.length);
      if (e.key === 'ArrowLeft') updateImage((currentIndex - 1 + projectImages.length) % projectImages.length);
      if (e.key === 'Escape') closeModal();
    });
  });
</script>