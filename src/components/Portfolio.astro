---
import ImageModal from './ImageModal.astro';
import '../styles/portfolio.css';
import work1 from '../images/portfolio/work-1.jpg';
import work2 from '../images/portfolio/work-2.jpg';
import work3 from '../images/portfolio/work-3.jpg';
import work4 from '../images/portfolio/work-4.jpg';
import work5 from '../images/portfolio/work-5.jpg';

// Portfolio section con información detallada
const portfolioItems = [
  {
    id: 1,
    images: [work1.src, work2.src, work3.src, work4.src],
    alt: 'Bolso tejido',
    title: 'Bolso tejido',
    time: '8 horas',
    hook: '5mm',
    technique: 'Punto medio',
    materials: 'Lana 100% acrílica',
    usage: 'Accesorio diario',    // <-- Nuevo
    amount: '300g aprox.',
  },
  {
    id: 2,
    images: [work2.src],
    alt: 'Amigurumi',
    title: 'Amigurumi',
    time: '6 horas',
    hook: '3mm',
    technique: 'Punto bajo cerrado',
    materials: 'Algodón suave, relleno poliéster',
    usage: 'Accesorio diario',    // <-- Nuevo
    amount: '300g aprox.',
  },
  {
    id: 3,
    images: [work3.src],
    alt: 'Tapestry crochet',
    title: 'Tapestry crochet',
    time: '12 horas',
    hook: '4mm',
    technique: 'Tapestry crochet',
    materials: 'Lana multicolor',
     usage: 'Accesorio diario',    // <-- Nuevo
    amount: '300g aprox.',
  },
  {
    id: 4,
    images: [work4.src],
    alt: 'Top de red',
    title: 'Top de red',
    time: '5 horas',
    hook: '4.5mm',
    technique: 'Puntos calados',
    materials: 'Hilo fino 100% algodón',
     usage: 'Accesorio diario',    // <-- Nuevo
    amount: '300g aprox.',
  },
  {
    id: 5,
    images: [work5.src],
    alt: 'Mantel boho',
    title: 'Mantel boho',
    time: '10 horas',
    hook: '5mm',
    technique: 'Punto V, motivos',
    materials: 'Algodón natural, teñido',
     usage: 'Accesorio diario',    // <-- Nuevo
    amount: '300g aprox.',
  },
];
---
<section class="portfolio crochet-bg-portfolio" id="portfolio">
  <div class="portfolio-inner">
    <div class="portfolio-header">
      <div class="portfolio-header-text">
        <p class="section-eyebrow-light">♥ Te ayudo a replicar las cosas que yo hago ♥</p>
        <h2 class="portfolio-title">Mis <em>bonitas</em> producciones<br/></h2>
      </div>
    </div>

    <div class="portfolio-grid">
      {portfolioItems.map((item) => (
        <article class="portfolio-card">
          <button
            class="portfolio-img-wrap portfolio-btn"
            type="button"
            aria-label={`Ver detalles de ${item.title}`}
            data-images={item.images.join(',')} data-title={item.title}
            data-time={item.time}
            data-hook={item.hook}
            data-technique={item.technique}
            data-materials={item.materials}
            data-usage={item.usage}
            data-amount={item.amount}
          >
            <img
              src={item.images[0]}
              alt={item.alt}
              class="portfolio-img"
              loading="lazy"
            /> 
            <div class="portfolio-overlay">
              <span class="portfolio-item-title">{item.title}</span>
              <span class="portfolio-item-cta">Ver detalles →</span>
            </div>
          </button>
        </article>
      ))}
    </div>
  </div>
</section>

<ImageModal />