---
// Workshops / Talleres section
import '../styles/workshops.css';
---

<section class="workshops crochet-bg-workshop" id="talleres">
  <div class="workshops-inner">

    <div class="workshops-text">
      <p class="section-eyebrow-light">✦ Clases personalizadas ✦</p>
      <h2 class="workshops-title">Taller de<br/><em>Crochet 1 a 1</em></h2>
      <p class="workshops-lead">
        Ofrezco talleres de crochet personalizados, adaptados a tu nivel y
        a lo que querés aprender. Desde los primeros puntos hasta técnicas
        más complejas.
      </p>
      <ul class="workshops-features">
        <li>
          <span class="feat-icon">🪢</span>
          <div>
            <strong>100% personalizado</strong>
            <p>Trabajemos a tu ritmo, con los proyectos que más te gustan.</p>
          </div>
        </li>
        <li>
          <span class="feat-icon">🪢</span>
          <div>
            <strong>Online o presencial</strong>
            <p>Vos elegís el formato que mejor se adapte a tu vida.</p>
          </div>
        </li>
        <li>
          <span class="feat-icon">🪢</span>
          <div>
            <strong>Todos los niveles</strong>
            <p>Principiantes absolutas y quienes quieren perfeccionarse.</p>
          </div>
        </li>
      </ul>
     
      <a
        href={"https://api.whatsapp.com/send?phone=541138733447&text=%C2%A1Buenas!%20Vi%20tu%20p%C3%A1gina%20%F0%9F%8C%90%20y%20trabajos%20de%20crochet%F0%9F%A7%B6%2C%20y%20quiero%20tener%20un%20clases%20con%20vos%2C%20ahora%20te%20digo%20mi%20nombre%20y%20que%20me%20gustar%C3%ADa%20hacer%20%F0%9F%99%82"}
        target="_blank"
        rel="noopener noreferrer"
        class="whatsapp-btn-workshops"
        aria-label="Contactar por WhatsApp"
      >
        <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Contactame por WhatsApp
      </a>
    </div>

   <div class="workshops-visual crochet-bg">
  <div class="workshops-video ">
    <iframe 
      src="https://www.youtube.com/embed/lhP7JR3V1Ww?rel=0&modestbranding=1" 
      title="Taller de Crochet" 
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
      allowfullscreen>
    </iframe>
  </div>
</div>

  </div>
</section>